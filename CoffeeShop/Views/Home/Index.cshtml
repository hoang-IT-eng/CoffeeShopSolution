@model IEnumerable<CoffeeShop.Models.Order>

@{
    ViewData["Title"] = "Ca phục vụ";
}

<h1>Ca phục vụ</h1>

<div class="stat-grid mb-4">
    <article class="stat-card">
        <span>Bàn trống</span>
        <strong>@ViewBag.EmptyTables</strong>
    </article>
    <article class="stat-card">
        <span>Đang phục vụ</span>
        <strong>@ViewBag.OccupiedTables</strong>
    </article>
    <article class="stat-card">
        <span>Đã đặt</span>
        <strong>@ViewBag.ReservedTables</strong>
    </article>
</div>

<!-- Đơn hàng đang chờ xử lý -->
<h3 class="mb-3">Đơn hàng đang chờ xử lý</h3>
@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Bàn</th>
                    <th>Thời gian tạo</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.Table?.Name</td>
                        <td>@order.CreatedAt.ToString("g")</td>
                        <td>@order.Total.ToString("C")</td>
                        <td>@order.Status</td>
                        <td>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary btn-sm">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        Không có đơn hàng nào đang chờ xử lý.
    </div>
}