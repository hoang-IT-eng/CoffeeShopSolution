@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthPage = controllerName.Equals("Account", StringComparison.OrdinalIgnoreCase);
    bool Is(string controller, string? action = null) =>
        controllerName.Equals(controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || actionName.Equals(action, StringComparison.OrdinalIgnoreCase));
    var pageTitle = ViewData["Title"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(pageTitle ?? "CoffeeShop")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
@if (isAuthPage)
{
    <div class="auth-screen">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-mark"><i class="fas fa-coffee"></i></div>
                <div>
                    <span class="brand-name">Artisan POS</span>
                    <span class="brand-sub">Quản lý quán cà phê</span>
                </div>
            </div>
            @RenderBody()
        </div>
    </div>
}
else
{
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark"><i class="fas fa-coffee"></i></span>
                <span>
                    <span class="brand-name">Artisan POS</span>
                    <span class="brand-sub">F&amp;B Coffee</span>
                </span>
            </a>
            <nav class="side-scroll">
                <div class="side-label">Vận hành</div>
                <a class="side-link @(Is("Dashboard") ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-chart-pie"></i><span>Tổng quan</span>
                </a>
                <a class="side-link @(Is("Home") ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-store"></i><span>Ca phục vụ</span>
                </a>
                <a class="side-link @(Is("Order", "Create") ? "is-active" : "")" asp-controller="Order" asp-action="Create">
                    <i class="fas fa-cash-register"></i><span>Bán hàng</span>
                </a>
                <a class="side-link @(Is("Order", "Index") || Is("Order", "Details") ? "is-active" : "")" asp-controller="Order" asp-action="Index">
                    <i class="fas fa-fire-burner"></i><span>Bếp &amp; đơn</span>
                </a>
                <a class="side-link @(Is("Table") ? "is-active" : "")" asp-controller="Table" asp-action="Index">
                    <i class="fas fa-border-all"></i><span>Sơ đồ bàn</span>
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                {
                    <a class="side-link @(Is("Payment") ? "is-active" : "")" asp-controller="Payment" asp-action="Index">
                        <i class="fas fa-receipt"></i><span>Thu ngân</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <div class="side-label">Quản trị</div>
                    <a class="side-link @(Is("MenuItem") ? "is-active" : "")" asp-controller="MenuItem" asp-action="Index">
                        <i class="fas fa-mug-hot"></i><span>Thực đơn</span>
                    </a>
                    <a class="side-link @(Is("Inventory") ? "is-active" : "")" asp-controller="Inventory" asp-action="Index">
                        <i class="fas fa-boxes-stacked"></i><span>Kho</span>
                    </a>
                    <a class="side-link @(Is("Customer") ? "is-active" : "")" asp-controller="Customer" asp-action="Index">
                        <i class="fas fa-user-group"></i><span>Khách hàng</span>
                    </a>
                    <a class="side-link @(Is("User") ? "is-active" : "")" asp-controller="User" asp-action="Index">
                        <i class="fas fa-id-badge"></i><span>Nhân viên</span>
                    </a>
                    <a class="side-link @(Is("Report") ? "is-active" : "")" asp-controller="Report" asp-action="Sales">
                        <i class="fas fa-chart-line"></i><span>Báo cáo</span>
                    </a>
                }
            </nav>
            <div class="side-user">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="side-user-name">@User.Identity.Name</div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="side-logout"><i class="fas fa-right-from-bracket"></i> Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="side-link" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket"></i><span>Đăng nhập</span></a>
                }
            </div>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <button class="menu-toggle" type="button" id="menuToggle" aria-label="Mở menu"><i class="fas fa-bars"></i></button>
                <div class="topbar-date">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</div>
            </header>
            <div class="workspace-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
}

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("menuToggle")?.addEventListener("click", function () {
            document.getElementById("sidebar")?.classList.toggle("is-open");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
